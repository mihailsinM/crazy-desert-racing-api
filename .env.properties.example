# Copy this file to .env.properties and replace the placeholder secrets.
# Never commit .env.properties.

DB_URL=jdbc:postgresql://localhost:5432/racing_db
DB_USERNAME=postgres
DB_PASSWORD=replace-with-your-local-database-password

CRAZY_SUPER_ADMIN_ENABLED=true
CRAZY_SUPER_ADMIN_EMAIL=replace-with-your-owner-email
CRAZY_SUPER_ADMIN_PASSWORD=replace-with-your-unique-owner-password
CRAZY_SUPER_ADMIN_NAME=Michael
